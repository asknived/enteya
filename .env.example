# ENTEYA Luxury Jewellery - Environment Configuration Template

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Business Communication
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Database Configuration (PostgreSQL / SQLite / MongoDB)
DATABASE_URL=postgresql://user:password@localhost:5432/enteya_db

# Authentication Secrets
SESSION_SECRET=your_super_secret_session_key_here
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Optional Payment Gateway Integration (Razorpay / Stripe)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Admin / CRM Configuration
ADMIN_DEFAULT_EMAIL=admin@enteya.in
ADMIN_DEFAULT_PASSWORD=your_admin_secure_password_here
